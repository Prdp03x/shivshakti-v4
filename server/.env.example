PORT=5000
NODE_ENV=development
MONGODB_URI=
SESSION_SECRET=

# Frontend origin(s) allowed by CORS. Exact match, no trailing slash, comma-separated.
# Production example: https://myapp.vercel.app
APP_ORIGIN=http://localhost:5173

# Cookies. Local dev: strict + false.
# Frontend on a DIFFERENT domain than the API (e.g. Vercel + Render, no proxy):
#   COOKIE_SAMESITE=none   (forces Secure cookies; needs HTTPS)
# Same-origin (proxy/rewrite) in production: COOKIE_SAMESITE=strict, COOKIE_SECURE=true
COOKIE_SAMESITE=strict
COOKIE_SECURE=false

ADMIN_USERNAME=
ADMIN_PASSWORD=
